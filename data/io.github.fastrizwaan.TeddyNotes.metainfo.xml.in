<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.fastrizwaan.TeddyNotes</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Teddy Notes</name>
  <summary>Take notes with dynamic WebKit Markdown live rendering</summary>
  <description>
    <p>
      Teddy Notes is a beautifully crafted note-taking application designed for GNOME and Libadwaita.
      It combines the clean, distraction-free interface of Iotas with the dynamic WebKit live Markdown-to-HTML rendering rendering engine.
    </p>
    <p>Key features include:</p>
    <ul>
      <li>Dynamic Markdown Parsing: format on the fly with live headings, lists, tables, and code blocks</li>
      <li>Interactive Todo Checklists: toggle tasks directly in the editor</li>
      <li>Distraction-free organization: folders, categories, and #tags</li>
      <li>Fast search and multi-note management</li>
      <li>Word and character count with reading time estimates</li>
      <li>Export to Markdown, HTML, and Plain text</li>
    </ul>
  </description>
  <developer_name>Mohammed Asif Ali Rizvan</developer_name>
  <url type="homepage">https://github.com/fastrizwaan/TeddyNotes</url>
  <url type="bugtracker">https://github.com/fastrizwaan/TeddyNotes/issues</url>
  <url type="vcs-browser">https://github.com/fastrizwaan/TeddyNotes</url>
  <launchable type="desktop-id">io.github.fastrizwaan.TeddyNotes.desktop</launchable>
  <provides>
    <binary>teddynotes</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.6" date="2026-10-23">
      <description>
        <p>Editor layout improvements:</p>
        <ul>
          <li>Added multi-column and centered single-column layouts with horizontal snapping</li>
          <li>Improved column navigation and viewport edge clipping</li>
        </ul>
      </description>
    </release>
    <release version="1.5" date="2026-10-09">
      <description>
        <p>New features and improvements in Teddy Notes 1.5:</p>
        <ul>
          <li>Fixed Horizontal Rule toolbar button functionality and enhanced divider insertion</li>
          <li>Clean block-level separator placement matching markdown '---' trigger</li>
        </ul>
      </description>
    </release>
    <release version="1.4" date="2026-10-09">
      <description>
        <p>New features and improvements in Teddy Notes 1.4:</p>
        <ul>
          <li>Updated application icon artwork</li>
          <li>Sanitized context menu: prevented browser reload, navigation actions, and developer inspection</li>
          <li>Protected editor view against accidental reloads and directory browsing</li>
          <li>Improved read-only mode context actions and direct external link opening</li>
        </ul>
      </description>
    </release>
    <release version="1.3" date="2026-10-08">
      <description>
        <p>New features and improvements in Teddy Notes 1.3:</p>
        <ul>
          <li>Standard editor view mode by default (keeps sidebar visible when opening and editing notes)</li>
          <li>Rebranded application to Teddy Notes with refreshed app icon</li>
          <li>Standard GNOME AlertDialog with horizontal button layout for link dialogs</li>
          <li>Smooth tag editing: arrow key navigation to exit badges and prevention of nested tag badges</li>
        </ul>
      </description>
    </release>
    <release version="1.2" date="2026-10-08">
      <description>
        <p>Improvements in version 1.2:</p>
        <ul>
          <li>Improved note link dialog layout and section heading popovers</li>
        </ul>
      </description>
    </release>
    <release version="1.1" date="2026-10-07">
      <description>
        <p>New features and improvements in Teddy Notes 1.1:</p>
        <ul>
          <li>Dedicated "Insert Note Link" toolbar button with chain-link icon (chain-link-symbolic)</li>
          <li>Interactive internal note link dialog: searchable note selector, title auto-sync, heading picker popover, and custom label display</li>
          <li>Reverted external link dialog (Ctrl+K) to clean, focused Label and URL fields</li>
          <li>Clean purple underlined styling for internal cross-note links without bracket clutter in both editor and rendered views</li>
          <li>Lossless markdown roundtrip preservation for clean internal wiki links</li>
        </ul>
      </description>
    </release>
    <release version="1.0" date="2026-10-07">
      <description>
        <p>New features and improvements in Teddy Notes 1.0:</p>
        <ul>
          <li>Cross-note wiki links: link directly to notes using [[Note Title]] syntax with bidirectional roundtrip preservation</li>
          <li>Deep heading navigation: link to sections using [[Note Title/Heading Name]] or [[/Heading Name]] with smooth scrolling and accent highlighting</li>
          <li>Link aliases: customize link display text using [[Note Title|alias]] or [[Note Title/Heading|alias]] syntax</li>
          <li>Cross-note back navigation history: Back button and Esc / Alt+Left retrace steps across visited notes before returning to the note list</li>
          <li>Context-aware Back button tooltip reflecting destination (previous note vs. note list)</li>
          <li>"Copy Link to Note" context menu action in the notes list for instant clipboard link sharing</li>
          <li>"Linked" smart sidebar filter: high-performance materialized SQLite column and index to view all notes with internal cross-links or external URLs</li>
        </ul>
      </description>
    </release>
    <release version="0.9" date="2026-10-07">
      <description>
        <p>New features and improvements in Teddy Notes 0.9:</p>
        <ul>
          <li>Full CommonMark specification compliance: strictly adhering to inline nesting rules, ATX headings, parenthesis ordered lists, and backslash escaping</li>
          <li>Two-entry Insert Link dialog (Ctrl+K) prefilled with active text selection and intelligent URL detection</li>
          <li>Direct click-to-open external links support in editor using Ctrl+Click</li>
          <li>Lighter, more accessible hyperlink styling matching Adwaita light and dark palettes</li>
          <li>Drag-and-drop ordering for sidebar categories allowing personalized note workflow organization</li>
          <li>Dedicated inline code button added to formatting action bar alongside code blocks</li>
          <li>Native Print support via XDG desktop portal (Ctrl+P) with offline Data URI image embedding</li>
          <li>Restored proper note list view column distributions for wide text snippets</li>
        </ul>
      </description>
    </release>
    <release version="0.8" date="2026-10-06">
      <description>
        <p>New features and improvements in Teddy Notes 0.8:</p>
        <ul>
          <li>Read-only note protection: existing notes open in view-only mode to prevent accidental edits, with a one-click Edit button (Ctrl+E) to unlock</li>
          <li>Sequential untitled note numbering: automatic sequential counter (Untitled Note 1, 2, 3...) that avoids duplicates and reuses deleted indices</li>
          <li>Page Setup dialog (Ctrl+Shift+P) with standard paper sizes (A4, US Letter, Legal, etc.), orientation, and configurable margins (inches, mm, cm, pt)</li>
          <li>High-performance materialized database columns for checklists (Todos) and lists for instantaneous sidebar counts and filtering</li>
          <li>SQLite composite indexing on note status and timestamps for ultra-fast note list loading</li>
          <li>Security and privacy hardening: lazy-loaded cryptographic dependencies, removal of persistent plaintext backup passwords, and XSS sanitization</li>
          <li>Clean WebKit script message handler lifecycle management preventing memory leaks</li>
          <li>Resolved GTK4 theme parser and Libadwaita active state accounting warnings</li>
        </ul>
      </description>
    </release>
    <release version="0.7" date="2026-10-04">
      <description>
        <p>New features and improvements in Teddy Notes 0.7:</p>
        <ul>
          <li>Open and import external Markdown (.md, .markdown) and plain text (.txt) files directly into notes (Ctrl+O)</li>
          <li>Automatic hashtag, category, checklist (Todos), and bullet list detection for imported and edited notes</li>
          <li>Dynamic category dropdown popover that matches the full width of the category entry widget</li>
          <li>Private and password-secured notes with PBKDF2-SHA256 salted encryption, dedicated sidebar entry, and on-lock content shielding</li>
          <li>Option to exclude private notes and master password when exporting database backups</li>
          <li>Real-time sidebar tag and note counts synchronization while editing in Split View</li>
          <li>Direct tag pill insertion into note content and instant autocomplete synchronization</li>
          <li>FlowBox card child sizing improvements to prevent category pill stretching</li>
        </ul>
      </description>
    </release>
    <release version="0.6" date="2026-10-03">
      <description>
        <p>New features and improvements in Teddy Notes 0.6:</p>
        <ul>
          <li>Privacy-first local database backup and restore system (.db and AES-256 encrypted .db.gpg)</li>
          <li>Standalone GPG symmetric encryption with loopback passphrase input, completely decoupled from system keyrings</li>
          <li>Optional automatic database backup on exit with configurable destination folder and password protection</li>
          <li>New dedicated "Backup &amp; Restore" preferences page in application settings</li>
          <li>Resolved GtkStack child selection warning when switching to batch note selection mode</li>
          <li>Fixed Gtk.FileDialog parent type compatibility with Adw.PreferencesDialog</li>
          <li>Fully offline Flatpak sandbox profile without network access requirements</li>
        </ul>
      </description>
    </release>
    <release version="0.5" date="2026-10-02">
      <description>
        <p>New features and improvements in Teddy Notes 0.5:</p>
        <ul>
          <li>Distraction-Free and Standard Editor view modes with smooth transitions and persistent preference</li>
          <li>Typography preferences with Font Family selection (System, Sans-Serif, Serif, and Monospace)</li>
          <li>Unified note text zoom (80% to 160%) and Card &amp; List text size options in Preferences</li>
          <li>One-click "Reset to Defaults" button for typography and text sizing</li>
          <li>Flicker-free draggable sidebar splitter with persistent width saving</li>
          <li>Quick "+" category button and collapsible chevrons for category hierarchies</li>
          <li>Tags dropdown popover menu for easy tag filtering and management</li>
          <li>Memory leak fixes and thread-safe background database save synchronization</li>
        </ul>
      </description>
    </release>
    <release version="0.4" date="2026-10-01">
      <description>
        <p>New features and improvements in Teddy Notes 0.4:</p>
        <ul>
          <li>Multi-window support with real-time SQLite database synchronization and concurrent conflict detection</li>
          <li>Dedicated Empty Trash action bar and clean "Trash is Empty" state</li>
          <li>Collapsible nested category sidebar with AdwExpanderRow chevron layout and accurate note counts</li>
          <li>Refined sidebar alignment with Nautilus-style horizontal dividers and icon spacing</li>
          <li>Quick sidebar filters for Todos (checklists) and Lists (bullet and numbered lists)</li>
          <li>Improved category and subcategory renaming showing leaf names while preserving full hierarchy paths</li>
          <li>Formatting toolbar pin toggle integrated directly into editor preferences</li>
        </ul>
      </description>
    </release>
    <release version="0.3" date="2026-09-29">
      <description>
        <p>New features and improvements in Teddy Notes 0.3:</p>
        <ul>
          <li>Interactive Grid and List view toggle with category sections and responsive FlowBox layout</li>
          <li>Note card visual previews including primary image thumbnails and partial table previews</li>
          <li>Refined card styling: flat appearance, borderless design, and consistent card heights</li>
          <li>Expanded Markdown support: highlight (==text==), strikethrough, subscript, superscript, emojis, symbols, and task checklists</li>
          <li>Responsive FlowBox formatting toolbar with highlight, erase, table, code block, and link tools</li>
          <li>Note tags (#tag) and category support with auto-completion and symbol mapping</li>
          <li>Base64 embedded image export and clean document export capabilities</li>
          <li>Improved table insertion, row/column controls, and interactive image resize handles</li>
        </ul>
      </description>
    </release>
    <release version="0.2" date="2026-09-27">
      <description>
        <p>Initial release of Teddy Notes featuring WebKit dynamic Markdown rendering and GNOME Libadwaita design.</p>
      </description>
    </release>
  </releases>
</component>
